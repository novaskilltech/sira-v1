{
  "name": "sira-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "seed": "node scripts/seed.mjs",
    "validate": "tsx scripts/validate.ts",
    "validate:public": "tsx scripts/validate.ts --public",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run validate && npm run demo:validate && npm run editorial:verify && npm run typecheck && vite build --mode demo",
    "build:public": "npm run validate:public && npm run typecheck && vite build --mode public",
    "preview": "vite preview --host 127.0.0.1",
    "demo:media": "node scripts/demo-media.mjs",
    "demo:models": "node scripts/technical-3d-fixtures.mjs",
    "demo:visuals": "node scripts/build-demo-visual-fixtures.mjs",
    "demo:validate": "node scripts/validate-demo-artifacts.mjs",
    "demo:voices": "tsx scripts/generate-openai-tts-demo.ts",
    "demo:voices:local": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$source = Get-Content -Raw -Encoding UTF8 'scripts/generate-local-tts-demo.ps1'; Invoke-Expression $source\"",
    "demo:voices:openrouter": "tsx scripts/generate-openrouter-tts-demo.ts",
    "tts:openrouter:models": "tsx scripts/list-openrouter-tts-models.ts",
    "drafts:optimize": "node scripts/optimize-draft-images.mjs",
    "editorial:prepare": "node scripts/prepare-editorial-workpacks.mjs",
    "editorial:validate": "node scripts/validate-editorial-workpacks.mjs",
    "claims:prepare": "node scripts/create-claims-register.mjs",
    "claims:validate": "node scripts/validate-claims-register.mjs",
    "writing:prepare": "node scripts/prepare-writing-register.mjs",
    "writing:validate": "node scripts/validate-writing-register.mjs",
    "sources:prepare": "node scripts/prepare-source-dossiers.mjs",
    "sources:validate": "node scripts/validate-source-dossiers.mjs",
    "sources:index:prepare": "node scripts/prepare-source-research-index.mjs",
    "sources:index:validate": "node scripts/validate-source-research-index.mjs",
    "narrations:prepare": "node scripts/prepare-narration-production.mjs",
    "narrations:validate": "node scripts/validate-narration-production.mjs",
    "cartography:prepare": "node scripts/prepare-cartography-dossiers.mjs",
    "cartography:validate": "node scripts/validate-cartography-dossiers.mjs",
    "physical:prepare": "node scripts/prepare-physical-recipe.mjs",
    "physical:validate": "node scripts/validate-physical-recipe.mjs",
    "editorial:verify": "npm run claims:validate && npm run writing:validate && npm run sources:validate && npm run sources:index:validate && npm run narrations:validate && npm run cartography:validate && npm run editorial:validate",
    "preflight:demo": "node scripts/preflight-demo.mjs",
    "editorial:import": "tsx scripts/import-approved-editorial.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "csv-parse": "7.0.3",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
